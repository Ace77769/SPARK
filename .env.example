# =========================================================================
# SPARK All-in-One Local & Production Environment Variables Configuration Template
# =========================================================================

# -------------------------------------------------------------------------
# 1. AI Microservice Configuration (ai-service/)
# -------------------------------------------------------------------------
# Get your personal key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_YourGroqApiKeyHere
GROQ_MODEL=openai/gpt-oss-20b
AI_PORT=8000

# -------------------------------------------------------------------------
# 2. Express Backend Configuration (server/)
# -------------------------------------------------------------------------
BACKEND_PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xnofjk2.mongodb.net/spark?retryWrites=true&w=majority
JWT_SECRET=use_a_long_random_alphanumeric_sequence_here_to_secure_auth

# Cloudinary Setup (For storing textbook PDFs and lectures uploads)
# Sign up and grab keys from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# URL to communicate with Python container (In docker-compose: http://ai-service:8000)
AI_SERVICE_URL=http://localhost:8000

# CORS Allowed Origin (In production, replace with frontend domain url on Render)
FRONTEND_URL=http://localhost:3000
